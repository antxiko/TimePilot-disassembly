# Puntos de entrada de Time Pilot (Konami, RC-703). ROM de 16 KB en 0x4000.
#
# El unico punto de entrada que declara el cartucho: la BIOS lee la cabecera
# "AB" y llama a INIT tras inicializar la maquina. Todo lo demas sale de seguir
# el flujo desde aqui.
0x4203   # INIT, declarado en la cabecera del cartucho (bytes 2-3: 03 42)

0x4037   # la rutina de interrupcion. INIT escribe `jp 0x4037` en el gancho
         # H.KEYI (0xFD9A): `ld a,0C3h / ld (0FD9Ah),a / ld hl,4037h /
         # ld (0FD9Bh),hl` en 0x4204-0x420E. La BIOS lo llama en cada interrupcion.

# --- El despachador de Time Pilot. El patron es
#         ld hl,<tabla> / call 0x5961 / call 0x415E (o call/jp 0x554E)
#     0x5961 hace `add a,a / hl += a / hl = (hl)`, y 0x415E, 0x554E y 0x6696 son
#     tres `jp (hl)` sueltos que sirven de "call (hl)". La tabla NO va detras del
#     call como en otros cartuchos de Konami, sino en un `ld hl,nn`, asi que hay
#     que declararla a mano.

# tabla 0x4118, 6 palabras (la carga 0x40A3)
